---
import ProductArt from './ProductArt.astro';

interface Props {
  art: string;
  uid: string;
  idx: string;
  name: string;
  sku: string;
  className?: string;
}
const { art, uid, idx, name, sku, className = '' } = Astro.props;
---

<figure class={`ficha ${className}`}>
  <div class="ficha__art">
    <ProductArt variant={art} uid={uid} />
    <i class="ficha__tick ficha__tick--tl" aria-hidden="true"></i>
    <i class="ficha__tick ficha__tick--tr" aria-hidden="true"></i>
    <i class="ficha__tick ficha__tick--bl" aria-hidden="true"></i>
    <i class="ficha__tick ficha__tick--br" aria-hidden="true"></i>
  </div>
  <figcaption class="ficha__cap">
    <span class="ficha__fig mono">FIG. {idx}</span>
    <span class="ficha__name">{name}</span>
    <span class="ficha__sku mono">{sku}</span>
  </figcaption>
</figure>

<style>
  .ficha {
    margin: 0;
  }

  .ficha__art {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-d);
  }

  .ficha__art :global(svg) {
    width: 100%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .ficha__tick {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--bone);
    opacity: 0.85;
  }

  .ficha__tick--tl {
    top: 10px;
    left: 10px;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .ficha__tick--tr {
    top: 10px;
    right: 10px;
    border-top: 1px solid;
    border-right: 1px solid;
  }

  .ficha__tick--bl {
    bottom: 10px;
    left: 10px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }

  .ficha__tick--br {
    bottom: 10px;
    right: 10px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }

  .ficha__cap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0.2rem;
    border-bottom: 1px solid var(--line-d);
    border-top: none;
  }

  .ficha__fig {
    color: var(--mist-2);
  }

  .ficha__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ficha__sku {
    color: var(--mist-2);
    text-transform: none;
    letter-spacing: 0.08em;
  }

  .ficha.on-paper .ficha__art {
    border-color: var(--line-l);
  }

  .ficha.on-paper .ficha__cap {
    border-color: var(--line-l);
  }

  .ficha.on-paper .ficha__tick {
    border-color: rgba(21, 23, 16, 0.55);
  }

  /* Modo hero — arte limitado en altura para caber en el viewport */
  .ficha--hero .ficha__art {
    aspect-ratio: 4 / 5;
    max-height: 68svh;
  }

  .ficha--hero .ficha__art :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Modo carrusel — ratio editorial ligeramente más corto */
  .ficha--slide .ficha__art {
    aspect-ratio: 4 / 4.55;
  }

  .ficha--slide .ficha__art :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .ficha__cap {
      gap: 0.6rem;
    }
    .ficha__sku {
      display: none;
    }
  }
</style>