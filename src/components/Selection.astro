---
import { dicts, productDisplay, type Locale } from '../i18n/ui.ts';
import type { CollectionEntry } from 'astro:content';
import ArrowIcon from './ArrowIcon.astro';
import ProductArt from './ProductArt.astro';

interface Props {
  products: CollectionEntry<'products'>[];
}

const { products } = Astro.props;
const locale = (Astro.currentLocale as Locale) ?? 'es';
const t = dicts[locale];

const total = products.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cue" id="productos" aria-labelledby="cue-title">
  <div class="shell">
    <header class="cue__head">
      <div class="cue__head-left">
        <p class="eyebrow reveal">{t.cue.eyebrow}</p>
        <h2 class="cue__title reveal" id="cue-title" style="--rd:.1s">{t.cue.title}</h2>
        <p class="cue__desc reveal" style="--rd:.2s">
          {t.cue.desc}
        </p>
      </div>

      <div class="cue__head-right reveal" style="--rd:.3s">
        <p class="cue__count mono" aria-live="polite">
          <span data-counter-current>{pad(1)}</span> / {pad(total)}
        </p>
        <div class="cue__nav">
          <button class="arrowbtn" type="button" data-nav="prev" aria-label={t.cue.prev}>
            <ArrowIcon n={16} />
          </button>
          <button class="arrowbtn" type="button" data-nav="next" aria-label={t.cue.next}>
            <ArrowIcon n={16} />
          </button>
        </div>
      </div>
    </header>
  </div>

  <div class="cue__viewport" id="cueViewport">
    <div class="cue__track" id="cueTrack" role="region" aria-label={t.cue.region} tabindex="0">
      {products.map((p, i) => {
        const disp = productDisplay(p.data, locale);
        return (
          <article
            class={`cue__photo${i === 0 ? ' is-active' : ''}`}
            id={`cue-slide-${p.data.slug}`}
            data-index={i}
            aria-label={disp.name}
          >
            <div class="cue__photo-art">
              <ProductArt variant={p.data.art} uid={`deck-${p.data.slug}`} />
            </div>
            <p class="cue__cap">
              <a href="#formulario" data-quote-product={disp.name}>
                {disp.name}
              </a>
              <span class="cue__fig mono">{pad(i + 1)}</span>
            </p>
          </article>
        );
      })}
    </div>
  </div>

  <div class="shell">
    <div class="cue__progress" aria-hidden="true">
      <span class="cue__progress-fill" data-counter-progress-fill></span>
    </div>
  </div>
</section>

<style>
  .cue {
    background: var(--carbon);
    color: var(--bone);
    padding-top: var(--sec-y);
  }

  .cue__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cue__title {
    margin-top: 1.2rem;
    max-width: 14ch;
  }

  .cue__desc {
    margin: 1.2rem 0 0;
    max-width: 30rem;
    color: var(--mist-2);
    font-size: var(--text-sm);
  }

  .cue__head-right {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .cue__count {
    color: var(--mist-2);
    letter-spacing: 0.2em;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .cue__count [data-counter-current] {
    color: var(--bone);
    font-weight: 500;
    font-size: 1.05rem;
  }

  .cue__nav {
    display: flex;
    gap: 0.6rem;
  }

  .arrowbtn {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line-d);
    color: var(--bone);
    cursor: pointer;
    border-radius: var(--radius);
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease),
      background-color 0.25s var(--ease), opacity 0.25s var(--ease);
  }

  .arrowbtn:hover:not(:disabled) {
    border-color: var(--pine-hi);
    color: var(--pine-hi);
  }

  .arrowbtn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .arrowbtn:first-child :global(svg) {
    transform: rotate(-90deg);
  }

  .arrowbtn:last-child :global(svg) {
    transform: rotate(90deg);
  }

  .cue__viewport {
    overflow: hidden;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cue__track {
    display: flex;
    align-items: stretch;
    position: relative;
    gap: clamp(1.6rem, 3.5vw, 3rem);
    transition: transform 0.75s var(--ease);
  }

  .cue__track.no-trans {
    transition: none;
  }

  .cue__photo {
    position: relative;
    flex: 0 0 auto;
    width: clamp(17rem, 30vw, 29rem);
  }

  .cue__photo-art {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-d);
    background: var(--line-d);
    aspect-ratio: 4 / 5;
  }

  .cue__photo-art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cue__cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.95rem 0.2rem 0;
  }

  .cue__cap a {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.25s var(--ease), border-bottom-color 0.25s var(--ease);
  }

  .cue__cap a:hover {
    color: var(--pine-hi);
    border-bottom-color: currentColor;
  }

  .cue__fig {
    color: var(--mist-2);
    letter-spacing: 0.2em;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .cue__progress {
    position: relative;
    height: 1px;
    background: var(--line-d);
    margin: 0;
  }

  .cue__progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    height: 1px;
    background: var(--pine-hi);
    transition: width 0.75s var(--ease);
  }

  @media (max-width: 780px) {
    .cue__track {
      gap: clamp(1rem, 4vw, 1.6rem);
    }

    .cue__photo {
      width: clamp(15rem, 82vw, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue__track {
      transition: none;
    }
    .cue__progress-fill {
      transition: none;
    }
  }
</style>

<script>
  const track = document.getElementById('cueTrack');
  const viewport = document.getElementById('cueViewport');
  const slides = Array.from(track?.querySelectorAll<HTMLElement>('.cue__photo') ?? []);
  const counter = document.querySelector<HTMLElement>('[data-counter-current]');
  const progressFill = document.querySelector<HTMLElement>('[data-counter-progress-fill]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-nav="prev"]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-nav="next"]');

  const total = slides.length;
  let index = 0;

  const readStep = () => {
    if (!slides.length) return 0;
    if (slides.length > 1) return slides[1].offsetLeft - slides[0].offsetLeft;
    return slides[0].offsetWidth;
  };

  const maxTranslate = () => {
    if (!viewport || !slides.length) return 0;
    const step = readStep();
    const last = slides[slides.length - 1];
    const right = step * (slides.length - 1) + last.offsetWidth;
    return Math.max(0, right - viewport.clientWidth);
  };

  const update = (noTransition = false) => {
    if (noTransition) track?.classList.add('no-trans');
    if (track) track.style.transform = `translateX(-${Math.min(index * readStep(), maxTranslate())}px)`;
    if (counter) counter.textContent = String(index + 1).padStart(2, '0');
    if (progressFill) progressFill.style.width = `${((index + 1) / total) * 100}%`;
    slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
    if (prevBtn) prevBtn.disabled = index === 0;
    if (nextBtn) nextBtn.disabled = index === total - 1;
    if (noTransition) requestAnimationFrame(() => track?.classList.remove('no-trans'));
  };

  const go = (to: number) => {
    const next = Math.max(0, Math.min(total - 1, to));
    if (next === index) return;
    index = next;
    update();
  };

  document.querySelectorAll('[data-nav]').forEach((btn) => {
    btn.addEventListener('click', () => go(index + (btn.getAttribute('data-nav') === 'next' ? 1 : -1)));
  });

  track?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'PageDown') {
      e.preventDefault();
      go(index + 1);
    } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      go(index - 1);
    }
  });

  let startX = 0;
  let deltaX = 0;
  viewport?.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    deltaX = 0;
  }, { passive: true });
  viewport?.addEventListener('touchmove', (e) => {
    deltaX = e.touches[0].clientX - startX;
  }, { passive: true });
  viewport?.addEventListener('touchend', () => {
    const th = 60;
    if (Math.abs(deltaX) > th) go(index + (deltaX < 0 ? 1 : -1));
  }, { passive: true });

  window.addEventListener('resize', () => {
    if (track) track.style.transform = `translateX(-${Math.min(index * readStep(), maxTranslate())}px)`;
  });

  update(true);
</script>