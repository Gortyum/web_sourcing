---
interface Props {
  n?: number;
}
const { n = 30 } = Astro.props;
---
<svg
  width={n}
  height={n}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <rect class="leaf-square" width="40" height="40" rx="3" fill="var(--pine)" />
  <path
    d="M20 30.5C10.5 27.5 7.5 20 11.5 11.5C19.5 12 24.5 14.5 26.5 19.5C27.5 21.5 27.9 24 26.8 26.8C24.5 29.8 22.5 31.2 20 30.5Z"
    fill="var(--bone)"
  />
  <path
    d="M12 13C17.5 10 25 11 29 17.5C23 15.5 16 15.5 12 13Z"
    fill="var(--pine-hi)"
  />
</svg>