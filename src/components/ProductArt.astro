---
/**
 * Ficha de producto — still-life ilustrado en estilo editorial.
 * Sustituye la fotografía con una composición de estudio: panel tonal,
 * luz superior, grano sutil y el sello de marca (la hoja) aplicado al
 * producto — el gesto de personalización que Eleni ofrece.
 *
 * Props:
 *  - variant: 'bottle' | 'tote' | 'notebook' | 'mug' | 'cap' | 'kit'
 *  - uid:    sufijo único para ids de gradientes/filtros (evita colisiones)
 */
interface Props {
  variant: string;
  uid: string;
}
const { variant, uid } = Astro.props;

const GRAIN = `
<filter id="grain-${uid}" x="0" y="0" width="100%" height="100%">
  <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" result="n"/>
  <feColorMatrix type="saturate" values="0" in="n" result="g"/>
  <feComponentTransfer in="g">
    <feFuncA type="linear" slope="0.055"/>
  </feComponentTransfer>
</filter>`;

/** Sello de marca — la hoja Eleni aplicada al producto. */
function seal(cx: number, cy: number, s: number, bg: string, fg: string, vein: string) {
  const leaf =
    'M20 30.5C10.5 27.5 7.5 20 11.5 11.5C19.5 12 24.5 14.5 26.5 19.5C27.5 21.5 27.9 24 26.8 26.8C24.5 29.8 22.5 31.2 20 30.5Z';
  const v = 'M12 13C17.5 10 25 11 29 17.5C23 15.5 16 15.5 12 13Z';
  return `
  <g transform="translate(${cx - 40 * s} ${cy - 40 * s}) scale(${s})">
    <circle cx="20" cy="20" r="20" fill="${bg}"/>
    <path d="${leaf}" fill="${fg}"/>
    <path d="${v}" fill="${vein}"/>
  </g>`;
}

/* ── Fondos de estudio por producto ─────────────────────────── */
const scenes: Record<string, { top: string; bottom: string }> = {
  bottle: { top: '#E9ECDA', bottom: '#CBD3B6' },
  tote: { top: '#F0E8D2', bottom: '#DCD0AE' },
  notebook: { top: '#26281F', bottom: '#151710' },
  mug: { top: '#F2EFE2', bottom: '#E2DCC5' },
  cap: { top: '#DDE1D2', bottom: '#C6CCB9' },
  kit: { top: '#E4DFD0', bottom: '#CCC4AB' },
};
const sc = scenes[variant] ?? scenes.bottle;

const PAIR = {
  bottle: 'bottle',
  tote: 'tote',
  notebook: 'notebook',
  mug: 'mug',
  cap: 'cap',
  kit: 'kit',
};
const shape = PAIR[variant] ?? 'bottle';
---

<svg viewBox="0 0 800 1000" role="img" class="p-art" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="bg-${uid}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="${sc.top}"/>
      <stop offset="1" stop-color="${sc.bottom}"/>
    </linearGradient>
    <radialGradient id="light-${uid}" cx="0.5" cy="0.12" r="0.85">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="vign-${uid}" cx="0.5" cy="1" r="1">
      <stop offset="0" stop-color="#151710" stop-opacity="0"/>
      <stop offset="1" stop-color="#151710" stop-opacity="0.16"/>
    </radialGradient>
    <filter id="soft-${uid}" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="14"/>
    </filter>
    <linearGradient id="metal-${uid}" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#DFE1D7"/>
      <stop offset="0.5" stop-color="#C6C9BC"/>
      <stop offset="1" stop-color="#A9AD9E"/>
    </linearGradient>
    <linearGradient id="pine-${uid}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4A7355"/>
      <stop offset="1" stop-color="#31603F" />
    </linearGradient>
    <linearGradient id="bone-${uid}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F4F1E3"/>
      <stop offset="1" stop-color="#DDD7C0"/>
    </linearGradient>
    ${GRAIN}
  </defs>

  <rect width="800" height="1000" fill="url(#bg-${uid})"/>
  <rect width="800" height="1000" fill="url(#light-${uid})"/>
  <rect width="800" height="1000" fill="url(#vign-${uid})"/>

  {
    shape === 'bottle' && (
      <>
        {/* Termo 500 — acero inoxidable */}
        <ellipse cx="400" cy="852" rx="175" ry="26" fill="#151710" opacity="0.22" filter="url(#soft-${uid})"/>
        <rect x="310" y="770" width="180" height="30" rx="12" fill="#8F9486"/>
        <rect x="318" y="352" width="164" height="422" rx="34" fill="url(#metal-${uid})"/>
        <rect x="350" y="296" width="100" height="92" rx="18" fill="#C7CABC"/>
        <rect x="334" y="390" width="22" height="330" rx="11" fill="#FFFFFF" opacity="0.30"/>
        <rect x="342" y="214" width="116" height="30" rx="10" fill="#3A3D33"/>
        <rect x="342" y="232" width="116" height="92" rx="18" fill="#25281F"/>
        <rect x="368" y="248" width="5" height="58" rx="2" fill="#3E4138"/>
        <rect x="385" y="248" width="5" height="58" rx="2" fill="#3E4138"/>
        <rect x="402" y="248" width="5" height="58" rx="2" fill="#3E4138"/>
        {/* Banda de personalización */}
        <rect x="318" y="480" width="164" height="122" rx="10" fill="#20221B" opacity="0.94"/>
        <rect x="332" y="498" width="136" height="2" fill="#FAF8F1" opacity="0.18"/>
        <rect x="332" y="584" width="136" height="2" fill="#FAF8F1" opacity="0.18"/>
        <Fragment set:html={seal(400, 528, 1.1, '#F4F1E4', '#3D6A4C', '#5D8A69')} />
        <text x="400" y="622" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="22" letter-spacing="4" fill="#FAF8F1" opacity="0.85">ET-TERMO-500</text>
      </>
    )
  }

  {
    shape === 'tote' && (
      <>
        {/* Tote algodón orgánico */}
        <ellipse cx="400" cy="760" rx="180" ry="22" fill="#151710" opacity="0.20" filter="url(#soft-${uid})"/>
        <path
          d="M286 352 C268 252 290 178 366 174 M498 352 C510 240 500 168 432 166"
          stroke="#C9C1A2" stroke-width="12" fill="none" stroke-linecap="round"
        />
        <path
          d="M302 352 C284 240 306 168 380 166 M472 352 C510 240 500 168 440 164"
          stroke="#E7E2CA" stroke-width="26" fill="none" stroke-linecap="round"
        />
        <path d="M262 350 L538 350 L514 720 Q511 748 486 748 L314 748 Q289 748 286 720 Z" fill="#E7E2CA"/>
        <rect x="258" y="344" width="284" height="14" rx="7" fill="#CFC7A8"/>
        <rect x="258" y="344" width="284" height="5" rx="3" fill="#BDB394" opacity="0.6"/>
        {/* Bandeau superior decorativo */}
        <path d="M262 350 L538 350 L534 384 L266 384 Z" fill="#D5CDAF"/>
        <path d="M268 358 L532 358" stroke="#B7AE8F" stroke-width="2" stroke-dasharray="8 6"/>
        {/* Bolsillo frontal */}
        <rect x="318" y="548" width="164" height="160" rx="8" fill="#DCD4B8"/>
        <rect x="328" y="558" width="144" height="140" rx="5" fill="none" stroke="#B9B091" stroke-width="2" stroke-dasharray="6 5"/>
        <Fragment set:html={seal(400, 600, 0.85, '#6B6652', '#EFEAD6', '#B9B091')} />
        <text x="400" y="690" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="19" letter-spacing="5" fill="#6B6652">ELENI</text>
      </>
    )
  }

  {
    shape === 'notebook' && (
      <>
        {/* Cuaderno tapa dura */}
        <ellipse cx="400" cy="772" rx="150" ry="20" fill="#151710" opacity="0.24" filter="url(#soft-${uid})"/>
        <rect x="508" y="280" width="24" height="448" rx="5" fill="#F2EFE2"/>
        <rect x="508" y="312" width="24" height="3" fill="#C9C3AC"/>
        <rect x="508" y="352" width="24" height="3" fill="#C9C3AC"/>
        <rect x="508" y="392" width="24" height="3" fill="#C9C3AC"/>
        <rect x="492" y="268" width="8" height="160" rx="3" fill="#8A8E80"/>
        <rect x="274" y="270" width="28" height="464" rx="7" fill="#2B4637"/>
        <rect x="286" y="284" width="3" height="436" stroke="#1A3525" stroke-width="3" stroke-dasharray="10 9"/>
        <rect x="297" y="292" width="3" height="420" stroke="#1A3525" stroke-width="3" stroke-dasharray="10 9"/>
        <rect x="296" y="270" width="216" height="464" rx="5" fill="url(#pine-${uid})"/>
        <rect x="296" y="270" width="4" height="464" rx="2" fill="#FFFFFF" opacity="0.12"/>
        <rect x="444" y="270" width="16" height="464" rx="4" fill="#1E241B"/>
        <Fragment set:html={seal(404, 372, 1.05, '#F4F1E4', '#3D6A4C', '#5D8A69')} />
        <text x="404" y="474" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="20" letter-spacing="4" fill="#F4F1E4" opacity="0.75">ET-NOTE-HC</text>
      </>
    )
  }

  {
    shape === 'mug' && (
      <>
        {/* Taza cerámica esmaltada */}
        <ellipse cx="400" cy="812" rx="160" ry="20" fill="#151710" opacity="0.18" filter="url(#soft-${uid})"/>
        <path d="M470 396 C556 388 566 528 484 562" stroke="#C9C0A6" stroke-width="10" fill="none" stroke-linecap="round"/>
        <path d="M472 392 C552 388 560 520 484 552" stroke="#DED7C2" stroke-width="22" fill="none" stroke-linecap="round"/>
        <ellipse cx="400" cy="352" rx="88" ry="24" fill="url(#bone-${uid})"/>
        <ellipse cx="400" cy="352" rx="70" ry="15" fill="#B9B298"/>
        <ellipse cx="396" cy="348" rx="42" ry="10" fill="#817D6B" opacity="0.55"/>
        <path d="M314 350 L486 350 L502 718 Q503 768 456 772 L344 772 Q297 768 298 718 Z" fill="url(#bone-${uid})"/>
        <rect x="326" y="376" width="18" height="320" rx="9" fill="#FFFFFF" opacity="0.30"/>
        <rect x="310" y="742" width="180" height="20" rx="9" fill="#C6BEA2"/>
        <Fragment set:html={seal(400, 528, 1.0, '#3D6A4C', '#F4F1E4', '#5D8A69')} />
        <text x="400" y="630" text-anchor="middle" font-family="'IBM Plex Mono',monospace" font-size="20" letter-spacing="4" fill="#6E6A58">ET-CER-330</text>
      </>
    )
  }

  {
    shape === 'cap' && (
      <>
        {/* Gorra trucker */}
        <ellipse cx="400" cy="808" rx="185" ry="22" fill="#151710" opacity="0.20" filter="url(#soft-${uid})"/>
        <path d="M282 470 C278 340 330 260 436 260 C522 260 576 318 556 452 L548 470 Z" fill="#D6D0B8"/>
        <path d="M286 470 L298 400 C306 316 362 280 436 280 C506 280 548 318 564 400 L574 470 Z" fill="url(#pine-${uid})"/>
        <path d="M436 470 C436 470 434 384 436 296" stroke="#2C4A38" stroke-width="4"/>
        <path d="M316 352 Q436 300 560 352" stroke="#2C4A38" stroke-width="3" stroke-dasharray="7 6"/>
        <rect x="430" y="258" width="12" height="8" rx="3" fill="#20221C"/>
        <rect x="280" y="470" width="300" height="30" rx="9" fill="#20221C"/>
        <rect x="284" y="474" width="292" height="3" stroke="#3C3E35" stroke-width="3" stroke-dasharray="8 6"/>
        <Fragment set:html={seal(430, 378, 1.05, '#F4F1E4', '#3D6A4C', '#5D8A69')} />
        <path d="M150 500 Q400 530 650 500 L658 526 Q400 554 142 526 Z" fill="#D8D2BA"/>
        <path d="M158 508 Q400 536 642 508 L650 526 Q400 554 150 526 Z" fill="#C6BE9F" opacity="0.65"/>
      </>
    )
  }

  {
    shape === 'kit' && (
      <>
        {/* Kit corporativo — caja + tapa */}
        <ellipse cx="400" cy="806" rx="200" ry="26" fill="#151710" opacity="0.22" filter="url(#soft-${uid})"/>
        <rect x="322" y="394" width="156" height="3" fill="#B3AB92"/>
        <path d="M296 470 L504 470" stroke="#FAF8F1" stroke-opacity="0.08" stroke-width="2"/>
        <rect x="306" y="424" width="188" height="46" fill="#2B2E27"/>
        <rect x="328" y="432" width="44" height="38" rx="6" fill="#E7E2CA" opacity="0.9"/>
        <rect x="382" y="434" width="26" height="36" rx="4" fill="#C7CABC" opacity="0.95"/>
        <rect x="296" y="470" width="208" height="300" rx="10" fill="#23251D"/>
        <rect x="296" y="470" width="208" height="300" rx="10" fill="none" stroke="#FAF8F1" stroke-opacity="0.05"/>
        <rect x="390" y="470" width="20" height="300" fill="#3D6A4C"/>
        <rect x="282" y="330" width="236" height="78" rx="10" fill="#F4F1E4"/>
        <rect x="282" y="330" width="236" height="14" rx="7" fill="#FFFFFF" opacity="0.35"/>
        <rect x="390" y="330" width="20" height="78" fill="#3D6A4C"/>
        <Fragment set:html={seal(400, 369, 0.9, '#3D6A4C', '#F4F1E4', '#7FA587')} />
        <path d="M404 556 L404 524 L426 508 L404 520 L382 508 L404 524 L404 556 Z" fill="#F4F1E4"/>
        <rect x="412" y="530" width="26" height="66" rx="3" fill="#F4F1E4"/>
        <rect x="412" y="530" width="26" height="66" rx="3" fill="none" stroke="#CCC4AB" stroke-width="2"/>
        <circle cx="425" cy="544" r="3" fill="#B9B091"/>
        <Fragment set:html={seal(425, 584, 0.55, '#3D6A4C', '#F4F1E4', '#7FA587')} />
      </>
    )
  }

  <rect width="800" height="1000" filter="url(#grain-${uid})" pointer-events="none"/>
</svg>