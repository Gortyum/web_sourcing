---
import { dicts, type Locale } from '../i18n/ui.ts';
import ArrowIcon from './ArrowIcon.astro';

const locale = (Astro.currentLocale as Locale) ?? 'es';
const t = dicts[locale];

const dateLabel = new Intl.DateTimeFormat(locale === 'pt' ? 'pt-BR' : 'es-CL', {
  month: 'long',
  year: 'numeric',
}).format(new Date());

type Token = { word: string; em?: boolean };
const tokens: Token[] = [
  ...t.hero.title.split(' ').map((word) => ({ word })),
  { word: t.hero.titleEm, em: true },
  ...t.hero.titleEnd.split(' ').map((word) => ({ word })),
];
---

<section class="hero" id="inicio" aria-label={locale === 'pt' ? 'Início' : 'Inicio'}>
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow reveal" style="--rd:.05s">{t.hero.eyebrow}</p>
      <h1 class="hero__title" data-hero-title>
        {tokens.map((tok, i) => (
          <>
            {i > 0 && ' '}
            <span class="hw">
              <span class="hw__in" style={`--wd:${(i * 0.08).toFixed(2)}s`}>
                {tok.em ? <em class="i hero__em">{tok.word}</em> : tok.word}
              </span>
            </span>
          </>
        ))}
      </h1>
      <p class="hero__lede reveal" style="--rd:.32s">
        {t.hero.sub}
      </p>
      <div class="hero__cta reveal" style="--rd:.46s">
        <a class="btn btn--primary btn--big" href="#formulario">
          {t.hero.cta} <ArrowIcon n={17} />
        </a>
        <a class="btn btn--outline btn--big" href="#proveedores">
          {t.hero.suppliers}
        </a>
        <a class="btn btn--text" href="#productos">
          {t.hero.viewProducts} <ArrowIcon dir="down" n={16} />
        </a>
      </div>
      <p class="hero__meta mono reveal" style="--rd:.6s">
        <span>{t.hero.meta1}</span>
        <span>{t.hero.meta2}</span>
      </p>
    </div>

    <div class="hero__art reveal" style="--rd:.4s">
      <form class="hform" id="contactForm" novalidate>
        <input type="hidden" name="lang" value={locale} />
        <label class="hform__field">
          <span>{t.contact.fName}</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="hform__field">
          <span>{t.contact.fEmail}</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="hform__field">
          <span>{t.contact.fMsg}</span>
          <textarea name="message" rows={4} placeholder={t.contact.msgPh}></textarea>
        </label>
        <button class="btn btn--primary btn--big hform__btn" type="submit" id="cFormSubmit" data-submit={t.contact.submit} data-sending={t.contact.sending}>
          <span id="cFormSubmitLabel">{t.contact.submit}</span> <ArrowIcon n={17} />
        </button>
        <p class="hform__error" id="cFormError" role="alert" hidden>{t.contact.sendError}</p>
        <p class="hform__done" id="cFormDone" hidden>
          <span class="hform__done-title">{t.contact.doneTitle}</span>
          <span>{t.contact.doneText}</span>
        </p>
        <p class="hform__note mono">
          {t.contact.note} <a href="mailto:eleni@elenisourcing.com">eleni@elenisourcing.com</a>
        </p>
      </form>
    </div>
  </div>

  <div class="shell hero__foot-meta">
    <p class="mono muted-d">{t.hero.strip}</p>
    <p class="mono muted-d">{t.hero.updated} {dateLabel}</p>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 7vh, 5rem));
    padding-bottom: 0;
    min-height: 100svh;
    display: flow-root;
    color: var(--bone);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }

  .hero__copy {
    min-width: 0;
    max-width: 44rem;
  }

  .hero .eyebrow {
    color: var(--bone);
  }

  /* Título — reveal palabra por palabra.
     Por defecto: SIEMPRE visible (sin máscara, sin opacidad).
     La animación solo se arma si JS corre, las fuentes cargan
     y no hay prefers-reduced-motion. Un fallo en cualquiera de
     esas condiciones deja el título visible, nunca oculto. */
  .hero__title {
    margin-top: 1.6rem;
    font-size: var(--text-hero);
    line-height: 1.04;
  }

  .hw {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.12em;
  }

  .hw__in {
    display: inline-block;
    transform: none;
    opacity: 1;
  }

  .hero__title[data-anim] .hw__in {
    transform: translateY(115%);
    opacity: 0;
  }

  .hero__title[data-anim][data-in] .hw__in {
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.95s cubic-bezier(0.22, 1, 0.36, 1) var(--wd, 0s),
      opacity 0.6s var(--ease) var(--wd, 0s);
  }

  .hero__em {
    color: var(--pine-hi);
  }

  .hero__lede {
    margin: 1.5rem 0 0;
    max-width: 30rem;
    color: rgba(250, 248, 241, 0.74);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2.4rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 2rem;
    row-gap: 0.4rem;
    margin: 2.2rem 0 0;
    color: var(--mist-2);
    letter-spacing: 0.16em;
  }

  .hero__art {
    min-width: 0;
  }

  .hform {
    background: var(--bone);
    color: var(--carbon);
    border: 1px solid var(--line-d);
    padding: clamp(1.6rem, 3vw, 2.6rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .hform__field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .hform__field span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mist);
  }

  .hform input,
  .hform textarea {
    width: 100%;
    border: 1px solid var(--line-l);
    border-radius: 0;
    background: #fff;
    padding: 0.85rem 0.9rem;
    font-size: 0.95rem;
    color: var(--carbon);
    transition: border-color 0.25s var(--ease);
  }

  .hform textarea {
    resize: vertical;
    min-height: 120px;
  }

  .hform input:focus,
  .hform textarea:focus {
    outline: none;
    border-color: var(--pine);
  }

  .hform__btn {
    align-self: flex-start;
    margin-top: 0.2rem;
  }

  .hform__error {
    margin: 0;
    color: #9c3f1e;
    font-size: 0.88rem;
  }

  .hform__error[hidden],
  .hform__done[hidden] {
    display: none;
  }

  .hform__done {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--mist);
    border-top: 1px solid var(--line-l);
    padding-top: 1rem;
  }

  .hform__done-title {
    color: var(--pine);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .hform__note {
    margin: 0.2rem 0 0;
    color: var(--mist);
    letter-spacing: 0.06em;
    text-transform: none;
    font-size: 0.72rem;
  }

  .hform__note a {
    color: var(--pine);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .hero__foot-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-block: 1.2rem;
    border-top: 1px solid var(--line-d);
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title .hw__in {
      transform: none;
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  const title = document.querySelector<HTMLElement>('[data-hero-title]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (title && !reduce) {
    let armed = false;
    const arm = () => {
      if (armed) return;
      armed = true;
      title.setAttribute('data-anim', '');
      setTimeout(() => title.setAttribute('data-in', ''), 60);
    };
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(arm).catch(arm);
    } else {
      arm();
    }
    setTimeout(arm, 2200);
  }

  const cform = document.getElementById('contactForm') as HTMLFormElement | null;

  cform?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!cform.checkValidity()) {
      cform.reportValidity();
      return;
    }

    const done = document.getElementById('cFormDone') as HTMLElement | null;
    const err = document.getElementById('cFormError') as HTMLElement | null;
    const btn = document.getElementById('cFormSubmit') as HTMLButtonElement | null;
    const label = document.getElementById('cFormSubmitLabel') as HTMLSpanElement | null;
    const origLabel = btn?.dataset.submit || '';

    if (done) done.hidden = true;
    if (err) err.hidden = true;
    if (label && btn?.dataset.sending) label.textContent = btn.dataset.sending;
    if (btn) btn.disabled = true;

    try {
      const res = await fetch('/api/contact', { method: 'POST', body: new FormData(cform) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (done) done.hidden = false;
      cform.reset();
    } catch {
      if (err) err.hidden = false;
    } finally {
      if (btn) btn.disabled = false;
      if (label && origLabel) label.textContent = origLabel;
    }
  });
</script>