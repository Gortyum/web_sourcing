---
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import Selection from './Selection.astro';
import Services from './Services.astro';
import Process from './Process.astro';
import Applications from './Applications.astro';
import About from './About.astro';
import CTASection from './CTASection.astro';
import QuoteForm from './QuoteForm.astro';
import Footer from './Footer.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  products: CollectionEntry<'products'>[];
}

const { products } = Astro.props;
---

<Navbar />

<main id="contenido">
  <Hero />
  <Selection products={products} />
  <Services />
  <Process />
  <Applications />
  <About />
  <CTASection />
  <QuoteForm products={products} />
</main>

<Footer />